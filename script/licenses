#!/bin/bash
#
# Generate third-party license information for embedding in the binary.
#
# Usage:
#   ./script/licenses <GOOS> <GOARCH>      Generate licenses for a single platform
#   ./script/licenses --check              Verify generation works for all release platforms
#
# The single-platform mode is called by goreleaser pre-build hooks to generate
# platform-specific license information that gets embedded via go:embed.
#
# The --check mode is used in CI to catch license generation issues before release.

set -euo pipefail

GO_LICENSES_VERSION="github.com/google/go-licenses/v2@3e084b0caf710f7bfead967567539214f598c0a2" # v2.0.1
GO_LICENSES_BIN=""

ensure_go_licenses() {
    if [ -n "$GO_LICENSES_BIN" ] && [ -x "$GO_LICENSES_BIN" ]; then
        return
    fi
    local bindir
    bindir="${RUNNER_TEMP:-/tmp}/repomod-go-bin"
    mkdir -p "$bindir"
    GO_LICENSES_BIN="$bindir/go-licenses"
    if [ -x "$GO_LICENSES_BIN" ]; then
        return
    fi
    echo "Installing go-licenses for host..."
    # Build/install for the host; target GOOS/GOARCH are set by callers for analysis.
    GOBIN="$bindir" GOOS="$(go env GOHOSTOS)" GOARCH="$(go env GOHOSTARCH)" go install "$GO_LICENSES_VERSION"
}

generate_licenses() {
    local goos="$1"
    local goarch="$2"
    local output_dir="$3"

    ensure_go_licenses

    echo "Generating licenses for ${goos}/${goarch}..."
    mkdir -p "${output_dir}"

    # Generate the report listing (name, license type, URL)
    GOOS="${goos}" GOARCH="${goarch}" "$GO_LICENSES_BIN" report ./... \
        --template .github/licenses.tmpl \
        --ignore github.com/cli/cli \
        --ignore github.com/alecthomas/chroma/v2 \
        > "${output_dir}/report.txt"

    # Save license files, stripping source code
    rm -rf "${output_dir}/third-party"
    GOOS="${goos}" GOARCH="${goarch}" "$GO_LICENSES_BIN" save ./... \
        --save_path="${output_dir}/third-party" \
        --ignore github.com/cli/cli \
        --ignore github.com/alecthomas/chroma/v2 \
        --force

    # Remove everything except LICENSE and NOTICE files. go-licenses save copies
    # entire dependency directories, including Go source code.
    if [ -d "${output_dir}/third-party" ]; then
        find "${output_dir}/third-party" -type f \
            ! -iname 'license*' \
            ! -iname 'notice*' \
            ! -iname 'copying*' \
            ! -iname 'unlicense*' \
            -delete
        # Clean up empty directories left behind
        find "${output_dir}/third-party" -type d -empty -delete
    fi
}

if [ "$1" = "--check" ]; then
    platforms=("darwin:amd64" "darwin:arm64" "linux:amd64" "linux:arm64")
    tmpdir=$(mktemp -d)
    trap 'rm -rf "$tmpdir"' EXIT

    for platform in "${platforms[@]}"; do
        IFS=: read -r goos goarch <<< "$platform"
        generate_licenses "$goos" "$goarch" "$tmpdir/$goos-$goarch"
    done
    echo "License generation check passed for all platforms."
else
    generate_licenses "$1" "$2" "internal/licenses/embed/${1}-${2}"
    echo "Licenses written to internal/licenses/embed/${1}-${2}"
fi
